# 个人 AI 分身站 · 生产环境变量模板（复制为 .env 并填真实值；.env gitignored，绝不提交）
# ⚠️ 本文件只放占位，不含任何真实密钥

DB_NAME=ragkb
DB_USERNAME=ragkb
DB_PASSWORD=ragkb

# 站长账号（BCrypt 哈希或本地明文）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT（强随机串）
JWT_SECRET=

# LLM（DeepSeek）
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=800
LLM_THINKING_NORMAL=disabled
LLM_THINKING_AGENT=low

# Embedding（硅基流动 bge-m3）
EMBEDDING_PROVIDER=auto
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3

# 应用
CORS_ORIGINS=https://zhengziheng.me,https://www.zhengziheng.me
PERSONA_NAME=郑梓恒

# 限流
RATE_LIMIT_PER_HOUR=50
LOGIN_RATE_LIMIT_PER_HOUR=10
