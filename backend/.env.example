# 个人 AI 分身站 · 环境变量模板（复制为 .env 并填写；.env 已被 .gitignore 忽略，绝不提交）
# ⚠️ 本文件只放占位，不包含任何真实密钥

# ===== 数据库(docker-compose 默认)=====
DB_HOST=pg
DB_PORT=5432
DB_NAME=ragkb
DB_USERNAME=ragkb
DB_PASSWORD=ragkb

# ===== 站长账号(配置注入,BCrypt 哈希;生产必填)=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== JWT(生产务必改为强随机串)=====
JWT_SECRET=change-me-in-production-please-1234567890

# ===== LLM(DeepSeek,OpenAI 兼容)=====
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=800
LLM_THINKING_NORMAL=disabled
LLM_THINKING_AGENT=low

# ===== Embedding(硅基流动 bge-m3;留空则本地 hash 兜底,中文质量差,上线必配)=====
EMBEDDING_PROVIDER=auto
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3

# ===== 应用 =====
CORS_ORIGINS=https://zhengziheng.me,https://www.zhengziheng.me,http://localhost:5173
PERSONA_NAME=邱俊景
KB_DIR=classpath:kb

# ===== 限流 =====
RATE_LIMIT_PER_HOUR=50
LOGIN_RATE_LIMIT_PER_HOUR=10
SENSITIVE_WORDS=薪资,工资,待遇,期望薪酬,期望薪资,月薪,年薪
