# ============================================================
# 本地密钥配置模板（复制为本目录下的 application-local.yml 使用；后者已 gitignore）
# 用法：
#   1) cp application-local.yml.example application-local.yml
#   2) 填下面两个 key
#   3) 启动：mvn spring-boot:run -Dspring-boot.run.profiles=local
# 降级：LLM 无 key → 抽取式拼接；Embedding 无 key → 本地 hash 向量（中文质量差，上线必配）
# ============================================================

# LLM（DeepSeek，OpenAI 兼容；生成回答用）
llm:
  api:
    key: sk-这里替换为你的DeepSeek-key
    # 可选：model / base-url / max-tokens
    # model: deepseek-v4-flash
    # base-url: https://api.deepseek.com/v1
    # max-tokens: 800
  # thinking:
  #   normal: disabled          # normal 快速兜底关思考，保首字 <3s
  #   agent: low                # agent 默认路径 low 档（disabled/low/high）

# Embedding（硅基流动 bge-m3；向量化用，DeepSeek 无此接口，必须另配）
embedding:
  provider: auto               # auto=有 key 用 API，否则本地兜底
  api:
    base-url: https://api.siliconflow.cn/v1
    key: sk-这里替换为你的硅基流动-key
    model: BAAI/bge-m3
